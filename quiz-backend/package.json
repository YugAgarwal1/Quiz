{
  "name": "quiz-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade Node.js + SQL Backend for Quiz Bird Application",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:init": "node src/scripts/initDb.js",
    "db:seed": "node src/scripts/seedFromFrontend.js",
    "db:reset": "node src/scripts/initDb.js && node src/scripts/seedFromFrontend.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2"
  }
}
